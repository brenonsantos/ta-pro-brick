# Configurações do Supabase para o Tá pro Brick
# Obtenha estas chaves no painel do Supabase em Project Settings > API

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Senha de proteção para a rota de administração (/admin) em modo de validação
VITE_ADMIN_PASSWORD=adminbrick
